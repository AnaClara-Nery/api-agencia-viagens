# Configuração de acesso ao banco de dados
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# Endereço do servidor MySQL/MariaDB
DB_HOST=localhost

# Usuário do banco
DB_USER=root

# Senha do usuário. Deixe vazio se o seu MySQL/MariaDB não exige senha
# (padrão do XAMPP e do Laragon).
DB_PASSWORD=

# Nome do banco criado pelo script database.sql
DB_NAME=agencia_viagens

# Porta em que a API vai subir
PORT=3000
